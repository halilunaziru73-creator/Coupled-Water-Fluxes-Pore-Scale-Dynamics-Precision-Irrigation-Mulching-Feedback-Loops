{
  "name": "swafl",
  "productName": "SWAFL",
  "version": "1.1.0",
  "description": "SWAFL - Soil Water, Atmosphere, Feedback and Layout workbench: irrigation, mulching and design simulation",
  "author": "Naziru Halilu <halilunaziru73@gmail.com>",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "web": "node serve.js",
    "dist": "electron-builder --win portable nsis",
    "dist:dir": "electron-builder --dir",
    "get-app": "node get-app.js"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "io.github.halilunaziru73.swafl",
    "productName": "SWAFL",
    "copyright": "Copyright (c) Naziru Halilu",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "serve.js",
      "app/**/*",
      "build/icon.png",
      "package.json"
    ],
    "icon": "build/icon.ico",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "SWAFL.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "SWAFL-Setup.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "shortcutName": "SWAFL"
    },
    "extraResources": [
      {
        "from": "docs/manual_v1.1.0",
        "to": ".",
        "filter": [
          "SWAFL_Manual_v1.1.0_Vol1_Guide.pdf"
        ]
      }
    ]
  }
}
