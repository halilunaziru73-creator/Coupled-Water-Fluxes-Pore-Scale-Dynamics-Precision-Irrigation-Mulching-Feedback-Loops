{
  "name": "swafl",
  "productName": "SWAFL",
  "version": "1.1.0",
  "description": "SWAFL - Soil Water, Atmosphere, Feedback and Layout workbench: irrigation, mulching and design simulation",
  "author": "Naziru Halilu <halilunaziru73@gmail.com>",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "web": "node serve.js",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --dir",
    "dist:mac": "electron-builder --mac dmg",
    "get-app": "node get-app.js",
    "get_app": "node get-app.js",
    "getapp": "node get-app.js"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "rcedit": "^4.0.1"
  },
  "build": {
    "appId": "io.github.halilunaziru73.swafl",
    "productName": "SWAFL",
    "copyright": "Copyright (c) Naziru Halilu",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "daisy-runner.js",
      "serve.js",
      "app/**/*",
      "build/icon.png",
      "package.json",
      "EULA.txt",
      "build/icon.ico"
    ],
    "icon": "build/icon.ico",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "runAfterFinish": true,
      "artifactName": "SWAFL.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": false,
      "shortcutName": "SWAFL",
      "uninstallDisplayName": "SWAFL",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "license": "build/EULA.txt"
    },
    "extraResources": [
      {
        "from": "docs/manual_v1.1.0",
        "to": ".",
        "filter": [
          "SWAFL_Manual_v1.1.0.pdf"
        ]
      },
      {
        "from": "daisy",
        "to": "daisy",
        "filter": [
          "**/*"
        ]
      }
    ],
    "afterPack": "build/afterPack.js"
  }
}
