;; Texture, hydraulic properties (Mualem / van Genuchten 
;; parameters) based on
;; Hansen et al. 2012

(defhorizon "ResFarm_sand Ap" USDA3
  (description "3-25 cm")
  (clay 0.107 [])(silt 0.222 [])(sand 0.671 [])(humus 0.03 [])
  (dry_bulk_density 1.49 [g/cm^3])
  (C_per_N 11.0 [g C/g N])
  (hydraulic M_vG (Theta_res 0.00 [])
                  (Theta_sat 0.395489 [])
                  (alpha 0.04769 [cm^-1])
                  (n 1.6 [])
                  (K_sat 0.5[cm/h])
                  (l -2.05473 []))
)
  
(defhorizon "ResFarm_loam Ap" USDA3
  (description "3-25 cm")
  (clay 0.107 [])(silt 0.222 [])(sand 0.671 [])(humus 0.03 [])
  (dry_bulk_density 1.49 [g/cm^3])
  (C_per_N 11.0 [g C/g N])
  (hydraulic M_vG (Theta_res 0.00 [])
                  (Theta_sat 0.395489 [])
                  (alpha 0.04769 [cm^-1])
                  (n 1.6 [])
                  (K_sat 0.1[cm/h])
                  (l -2.05473 []))
)
  
  


