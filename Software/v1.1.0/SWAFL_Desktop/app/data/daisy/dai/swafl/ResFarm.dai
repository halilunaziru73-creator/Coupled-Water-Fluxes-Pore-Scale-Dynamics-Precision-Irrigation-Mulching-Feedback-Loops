  (description "33-120 cm")
  (clay 0.222 [])(silt 0.195 [])(sand 0.583 [])(humus 0.016 [])
  (dry_bulk_density 1.65 [g/cm^3])
  (C_per_N 11.0 [g C/g N])
  (hydraulic M_vG (Theta_res 0.0 [])
                  (l -4.0323 [])
                  (n 1.6 [])
                  (alpha 0.0565146 [cm^-1])
                  (K_sat 0.3148 [cm/h])
                  (Theta_sat 0.356969 []))
)

(defhorizon "ResFarm_loam Bt" USDA3
  (description "33-120 cm")
  (clay 0.222 [])(silt 0.195 [])(sand 0.583 [])(humus 0.016 [])
  (dry_bulk_density 1.65 [g/cm^3])
  (C_per_N 11.0 [g C/g N])
  (hydraulic M_vG (Theta_res 0.0 [])
                  (l -4.0323 [])
                  (n 1.3 [])
                  (alpha 0.0565146 [cm^-1])
                  (K_sat 0.06 [cm/h])
                  (Theta_sat 0.356969 []))
)









(defhorizon "ResFarm_sand C" USDA3
  (description "120-200 cm")
  (clay 0.207 [])(silt 0.235 [])(sand 0.558 []) (humus 0.01 [])
  (dry_bulk_density 1.69 [g/cm^3])
  (C_per_N 11.0 [g C/g N])
  (hydraulic M_vG (Theta_res 0.000 [])
                  (Theta_sat 0.348314 [])
                  (alpha 0.0476257 [cm^-1])
                  (n 1.6 [])  
                  (K_sat 0.50000 [cm/h])
                  (l -3.60322 []))
)


(defhorizon "ResFarm_loam C" USDA3
  (description "120-200 cm")
  (clay 0.207 [])(silt 0.235 [])(sand 0.558 []) (humus 0.01 [])
  (dry_bulk_density 1.69 [g/cm^3])
  (C_per_N 11.0 [g C/g N])
  (hydraulic M_vG (Theta_res 0.000 [])
                  (Theta_sat 0.348314 [])
                  (alpha 0.0476257 [cm^-1])
                  (n 1.3 [])  
                  (K_sat 0.10 [cm/h])
                  (l -3.60322 []))
)







;; --------------------------------------------------------
;; Macropores / Biopores

(defbiopore common matrix
  (K_wall_relative 1 [%])
  (allow_upward_flow false))

(defbiopore "matrix_0-25cm"
   (common (height_start 0 [cm])
           (height_end -25 [cm])
           (density 100 [m^-2])
           (diameter 2 [mm]))) 
           
(defbiopore "matrix_30-120cm"
   (common (height_start -30 [cm])
           (height_end -120 [cm])
           (diameter 4 [mm])
           (density 7 [m^-2]))) 
                    
;; --------------------------------------------------------

;; Defining the ResFarm soil profile;
(defcolumn "ResFarm column" default
  (Surface original (DetentionCapacity 5.0 [mm])
           (ReservoirConstant 60 [h^-1]))
  (Soil (MaxRootingDepth 150 [cm])
        (border -100 [cm])  
        (horizons ;(-3   [cm] "Surface Ap")
                  (-32  [cm] "ResFarm_loam Ap")
                  ;(-32  [cm] "ResFarm Bplow pan")
                  (-120 [cm] "ResFarm_loam Bt")
                  (-200 [cm] "ResFarm_loam C")))

    (Movement vertical 
        (Tertiary none))   

   (Groundwater aquitard
    (K_aquitard 0.001 [cm/h])
    (Z_aquitard 200 [cm])
    (pressure_table const -2.5 [m]))

  (OrganicMatter original (init (input 3000 [kg C/ha/y]) (end -25 [cm])))
  (Chemistry original 
      (combine (N (reaction nitrification
                           (denitrification
                           (water_factor (0.8 0.0) (0.9 0.2) (1.0 1.0))))) ("Trace List")))
   )
 
;; Defining the ResFarm soil profile;
(defcolumn "ResFarm_sand column" default
  
  (Soil (MaxRootingDepth 150 [cm])
        (border -100 [cm])  
        (horizons  (-25  [cm] "ResFarm_sand Ap")
                  (-120 [cm] "ResFarm_sand Bt")
                  (-200 [cm] "ResFarm_sand C")))

    (Movement vertical 
        (Tertiary none))   

   (Groundwater deep)

  (OrganicMatter original (init (input 3000 [kg C/ha/y]) (end -25 [cm])))
  (Chemistry original 
      (combine (N (reaction nitrification
                           (denitrification
                           (water_factor (0.8 0.0) (0.9 0.2) (1.0 1.0))))) ("Trace List")))
   )








;; ResFarm column with and biopores
(defcolumn "ResFarm column; Biopores" "ResFarm column" 
  (Movement vertical 
        (Tertiary (biopores (active_msg none)
              (classes ("matrix_0-25cm") 
                       ("matrix_30-120cm"))))
  ))

;; 1D model with free drainage
(defcolumn "ResFarm 1D; Free drainage" "ResFarm column" 
  (Groundwater deep))

;; 1D model with biopores & free drainage
(defcolumn "ResFarm 1D; Biopores; Free drainage" "ResFarm column; Biopores" 
  (Groundwater deep))
  
;; 1D model with pipe drainage  
(defcolumn "ResFarm 1D; Pipe drainage" "ResFarm column" 
  (Drain lateral
    (L 18 [m])
    (x 9.0 [m])
    (pipe_position -110.0 [cm])))

;; 1D model with biopores & pipe drainage  
(defcolumn "ResFarm 1D; Biopores; Pipe drainage" "ResFarm column; Biopores" 
  (Drain lateral
    (L 18 [m])
    (x 9.0 [m])
    (pipe_position -110.0 [cm])))
  
