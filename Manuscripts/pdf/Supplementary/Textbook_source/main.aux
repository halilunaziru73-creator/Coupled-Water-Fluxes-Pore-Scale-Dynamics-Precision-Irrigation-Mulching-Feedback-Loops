\@writefile{toc}{\contentsline {section}{\numberline {22.5}The memory of soil water and the rate-competition law}{635}{section.22.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {22.1}{\ignorespaces Conceptual and analytical framework. Antecedent storage released from the root zone can leave as drainage, soil evaporation, transpiration or other evaporation (memory fates $\phi $, estimated from E9). An imposed change in evaporative loss is offset by drainage, irrigation or transpiration (loss fates $\psi $, estimated from E16 and E7). The recoverable fraction of an evaporation saving is $1-\psi _D$.}}{636}{figure.22.1}\protected@file@percent }
\newlabel{fig:a22_1}{{22.5}{636}{The memory of soil water and the rate-competition law}{figure.22.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22.2}{\ignorespaces Hydraulic properties of the ten soils from the equation of the paper. The ordering by shape parameter $n$ is the ordering on which the main results are organised.}}{637}{figure.22.2}\protected@file@percent }
\newlabel{fig:a22_2}{{22.5}{637}{The memory of soil water and the rate-competition law}{figure.22.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22.3}{\ignorespaces Storage release $\bar  R$ (mm\,yr$^{-1}$) versus initial suction $h_0$ in the E9 lattice, one panel per soil (a--j, ordered by decreasing van Genuchten $n$). Lines are rain scales $P=0.5$--1.4 (colour bar). Wetter starts (small $h_0$) release more storage; the response saturates early in coarse soils and extends over the full $h_0$ range in fine soils.}}{637}{figure.22.3}\protected@file@percent }
\newlabel{fig:a22_3}{{22.5}{637}{The memory of soil water and the rate-competition law}{figure.22.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22.4}{\ignorespaces (a) Memory fates $\phi $ of released antecedent storage (E9; error bars: bootstrap 95\,\% CI for drainage). (b) Loss fates $\psi _D$ (drainage) and $\psi _I$ (irrigation) of an evaporation-factor increase (E16). (c) Drainage share of the evaporation saving from mulch (E7). Soils are ordered by decreasing $\phi _D$.}}{638}{figure.22.4}\protected@file@percent }
\newlabel{fig:a22_4}{{22.5}{638}{The memory of soil water and the rate-competition law}{figure.22.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22.5}{\ignorespaces Relationship between the memory fate $\phi _D$ (E9) and four soil-level predictors: (a) van Genuchten $n$, (b) $\log _{10}K_s$ (eight soils), (c) $\mathit  {TAW}$ to 1\,m, (d) effective saturation at 100\,cm. Spearman $\rho $ given in each panel.}}{638}{figure.22.5}\protected@file@percent }
\newlabel{fig:a22_5}{{22.5}{638}{The memory of soil water and the rate-competition law}{figure.22.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22.6}{\ignorespaces Rate-competition law. (a) $\phi _D$ against $K_s$ with the fitted curve $K_s/(K_s+q^\ast )$; crosses mark implied $K_s$ for S01 and S02. (b) Leave-one-soil-out predictions against observations (RMSE 0.058). (c) LOSO RMSE of each predictor of $\phi _D$ (asterisk: eight soils; the other predictors are shown for all ten soils, and like-for-like eight-soil values are given in the equation of the paper).}}{639}{figure.22.6}\protected@file@percent }
\newlabel{fig:a22_6}{{22.5}{639}{The memory of soil water and the rate-competition law}{figure.22.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22.7}{\ignorespaces Modifiers of the drainage share $\psi _D$ in E16. Each line is a soil (colour: $n$); (a) rainfall scale, (b) warming, (c) trigger suction, (d) irrigation dose.}}{639}{figure.22.7}\protected@file@percent }
\newlabel{fig:a22_7}{{22.5}{639}{The memory of soil water and the rate-competition law}{figure.22.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22.8}{\ignorespaces Cross-experiment transfer. (a) $\psi _D$ from E16 against $\phi _D$ from E9; (b) $\psi _D$ from the mulch lattice E7 against $\phi _D$; (c) E7 against E16. Each point is a soil, coloured by $n$ (as in the equation of the paper).}}{639}{figure.22.8}\protected@file@percent }
\newlabel{fig:a22_8}{{22.5}{639}{The memory of soil water and the rate-competition law}{figure.22.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22.9}{\ignorespaces Recoverable fraction $1-\psi _D$ by soil for the E16 and E7 contrasts.}}{640}{figure.22.9}\protected@file@percent }
\newlabel{fig:a22_9}{{22.5}{640}{The memory of soil water and the rate-competition law}{figure.22.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22.10}{\ignorespaces Robustness of the key associations. (a) Permutation distribution of Spearman $\rho $ between $n$ and $\phi _D$ (solid line: observed; dotted: its mirror). (b) Bootstrap 95\,\% intervals of five rank associations (10\,000 resamples).}}{640}{figure.22.10}\protected@file@percent }
\newlabel{fig:a22_10}{{22.5}{640}{The memory of soil water and the rate-competition law}{figure.22.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22.11}{\ignorespaces Climate surface of the drainage share $\psi _D$ for coarse loam (S01) from the E11 lattice. (a) $\psi _D$ over rain scale and warming (white contours), (b) $\psi _D$ against $P$ for selected warming levels, (c) $\psi _D$ against warming for selected rain scales.}}{641}{figure.22.11}\protected@file@percent }
\newlabel{fig:a22_11}{{22.5}{641}{The memory of soil water and the rate-competition law}{figure.22.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22.12}{\ignorespaces Drivers of soil hydraulic properties and their coupling to the soil--plant--atmosphere continuum. (a) Memory fate $\phi _D$ as a function of saturated conductivity $K_s$: simulated values for the eight soils with literature $K_s$ (points) and the rate-competition law (line); arrows show the implied change for a threefold increase or decrease in $K_s$ from 20\,cm\,d$^{-1}$ (law implication, not simulation).}}{641}{figure.22.12}\protected@file@percent }
\newlabel{fig:a22_12}{{22.5}{641}{The memory of soil water and the rate-competition law}{figure.22.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22.13}{\ignorespaces Implied change of the memory fate with soil structure over time and with management, from the fitted rate-competition law (the equation of the paper, $q^\ast =71.5$\,cm\,d$^{-1}$). These are illustrative scenarios under assumed multipliers and rates, not simulation results.}}{642}{figure.22.13}\protected@file@percent }
\newlabel{fig:a22_13}{{22.5}{642}{The memory of soil water and the rate-competition law}{figure.22.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22.14}{\ignorespaces Simulation evidence on structure, time and mulching (Daisy ensemble, mean annual values). (a) Run set E7, strong against weak mulch (vapour-flux factor 0.3 against 0.9, capacity 2\,mm): evaporation saved, irrigation saved and extra drainage by soil. (b) Run set E5, rainfed drainage of four finer soils against the consolidation rate $\tau _c$ for conventional tillage (solid) and the no-till value (dotted).}}{642}{figure.22.14}\protected@file@percent }
\newlabel{fig:a22_14}{{22.5}{642}{The memory of soil water and the rate-competition law}{figure.22.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22.15}{\ignorespaces One Daisy 7.1.14 run of the loam written by SWAFL 1.1.0 with the van Genuchten--Mualem parameters of every horizon as given (blue) and scaled toward a faster-draining soil (orange: $K_\mathrm  {sat}\times 4$, $\alpha \times 2$, $(n-1)\times 1.3$, $\theta _s\times 1.1$, $l+1$). (a) Cumulative matrix percolation, (b) cumulative actual evapotranspiration, (c) totals of the two seasons with the difference. Daily logs of Daisy, unchanged; script \mbox  {reproducibility/fig\_vg\_check.py}.}}{643}{figure.22.15}\protected@file@percent }
\newlabel{fig:a22_15}{{22.5}{643}{The memory of soil water and the rate-competition law}{figure.22.15}{}}
\csgappto{chsec@22}{\featitem{6.}{The audit of the water balance and the compact law of evapotranspiration}}
\csgappto{chtoc@22}{6.\ The audit of the water balance and the compact law of evapotranspiration.\ \ }
\@writefile{toc}{\contentsline {section}{\numberline {22.6}The audit of the water balance and the compact law of evapotranspiration}{643}{section.22.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {22.16}{\ignorespaces Pipeline for interpretable discovery. The pipeline recovers the known water balance as a positive control, audits partitions, measures the dimension of the partition manifold and fits sparse laws with LOSO/LOEO validation against gradient boosting. Controls (dashed purple boxes) are shown at the bottom and outputs at the top; purple hexagons are processing blocks, the pink stippled box is the data store, peach boxes are outputs and dotted lines are flows of information.}}{644}{figure.22.16}\protected@file@percent }
\newlabel{fig:a22_16}{{22.6}{644}{The audit of the water balance and the compact law of evapotranspiration}{figure.22.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22.17}{\ignorespaces Linear invariants. (a) Singular values of the seven-flux matrix for the real data and for column-permuted data. (b) Coefficients of the smallest right singular vector (scaled so $c_{\mathit  {ET}}=-1$) with bootstrap intervals. (c) Storage residual $\Delta S/W$ by experiment: E8 and E9 do not close. (d) Unattributed share of ET, $R/\mathit  {ET}$, by experiment.}}{645}{figure.22.17}\protected@file@percent }
\newlabel{fig:a22_17}{{22.6}{645}{The audit of the water balance and the compact law of evapotranspiration}{figure.22.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22.18}{\ignorespaces The unattributed term $R$. (a) $R$ and canopy evaporation in E4 by irrigation method. (b) $R$ against annual rain in E9 (rainfed, light points), with the linear fit and the ten E0 baselines.}}{645}{figure.22.18}\protected@file@percent }
\newlabel{fig:a22_18}{{22.6}{645}{The audit of the water balance and the compact law of evapotranspiration}{figure.22.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22.19}{\ignorespaces Partition manifold and its sensitivity to zero handling. (a) Variance explained by the first three clr-PCA components for five zero-replacement floors. (b) Scores on the first two components (1\,mm floor) coloured by $\ln (W/\mathit  {TAW})$. (c) Loadings of the five fates on the first two components.}}{646}{figure.22.19}\protected@file@percent }
\newlabel{fig:a22_19}{{22.6}{646}{The audit of the water balance and the compact law of evapotranspiration}{figure.22.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22.20}{\ignorespaces Compact ET law. (a) Leave-one-experiment-out predictions of the three-term law versus Daisy ET. (b) Gradient-boosting benchmark. (c) Fitted coefficients across the 17 LOEO folds. (d) LOEO MAPE by experiment. (e) The law at $I=200$\,mm for four soils (grey dashed: ET $=W$). (f) Drainage derived from closure, $W-\widehat  {\mathit  {ET}}$, versus Daisy drainage ($R^2=0.69$, RMSE 64\,mm; E8 and E9 excluded).}}{646}{figure.22.20}\protected@file@percent }
\newlabel{fig:a22_20}{{22.6}{646}{The audit of the water balance and the compact law of evapotranspiration}{figure.22.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22.21}{\ignorespaces Irrigation compensation $\kappa $ is not universal. (a) Per-soil $\kappa $ in E16 (paired $P=0.5\to 1.5$) with the pooled estimate and bootstrap interval. (b) Slope of water input on rain in single-soil lattices (95\,\% intervals). (c) Mean $\kappa $ by factor level in E16.}}{647}{figure.22.21}\protected@file@percent }
\newlabel{fig:a22_21}{{22.6}{647}{The audit of the water balance and the compact law of evapotranspiration}{figure.22.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22.22}{\ignorespaces Water fates by soil in the 15 near-equilibrium experiments (E8, E9 excluded). (a) Mean fate shares of water input $W$, soils ordered by decreasing $n$. (b) Number of valid runs per soil. (c) Median share of the unattributed term in ET.}}{647}{figure.22.22}\protected@file@percent }
\newlabel{fig:a22_22}{{22.6}{647}{The audit of the water balance and the compact law of evapotranspiration}{figure.22.22}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22.23}{\ignorespaces Pattern of the 149 failed runs. (a) Failed runs per soil, as a percentage of the 519 runs per soil (counts above bars). (b) Failed fraction in S02 against irrigation depth per event in E10. (c) Failed fraction in S02 against rain scale. (d) Annual drainage at 1\,m for valid and failed runs, normalised as densities; negative drainage of several hundred millimetres occurs only in failed runs.}}{648}{figure.22.23}\protected@file@percent }
\newlabel{fig:a22_23}{{22.6}{648}{The audit of the water balance and the compact law of evapotranspiration}{figure.22.23}{}}
